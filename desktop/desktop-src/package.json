{
  "name": "nusatunnel-desktop-src",
  "private": true,
  "version": "2.2.0",
  "description": "NusaTunnel 2.2 — shell desktop Electron + renderer React TypeScript (liquid glass)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
