<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- NusaTunnel "Midnight Aurora" — latar: langit tengah malam + cahaya aurora -->

    <!-- dasar mid-night -->
    <path android:fillColor="#0A0E1F"
        android:pathData="M0,0h108v108h-108z"/>

    <!-- aurora cyan, kiri-bawah -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="21.6" android:centerY="88.6" android:gradientRadius="59">
                <item android:offset="0" android:color="#3822D3EE"/>
                <item android:offset="1" android:color="#0022D3EE"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- aurora violet, kanan-atas -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="82.1" android:centerY="25.9" android:gradientRadius="59">
                <item android:offset="0" android:color="#428B5CF6"/>
                <item android:offset="1" android:color="#008B5CF6"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- cahaya lembut di tengah, memperkuat monogram -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="54" android:gradientRadius="37">
                <item android:offset="0" android:color="#1F38BDF8"/>
                <item android:offset="1" android:color="#0038BDF8"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
